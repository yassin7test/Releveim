# Configuration par défaut pour Bank Statement Processor
# Copier ce fichier en .env et modifier les valeurs si nécessaire

# Code journal par défaut
DEFAULT_JOURNAL=BNK

# Comptes comptables par défaut (Plan comptable marocain)
DEFAULT_COMPTE_BANCAIRE=514100
DEFAULT_COMPTE_FOURNISSEUR=441100
DEFAULT_COMPTE_CLIENT=342100
DEFAULT_COMPTE_CHARGES=613400

# Format de sortie par défaut : sage100_txt, sage100_csv, sage_i7, simple_csv
DEFAULT_FORMAT=sage100_txt

# Répertoire de sortie par défaut
DEFAULT_OUTPUT_DIR=./output
