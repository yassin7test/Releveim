# Configuration Bank Statement Processor — Plan Comptable Marocain (PCM)
# Copier ce fichier en .env et adapter si nécessaire

# Code journal (BQ = Banque, selon votre paramétrage Sage)
DEFAULT_JOURNAL=BQ

# Comptes bancaires — PCM Maroc 4 chiffres
DEFAULT_COMPTE_BANCAIRE=5141       # Banques — comptes courants
DEFAULT_COMPTE_CLIENT=3421         # Clients et comptes rattachés
DEFAULT_COMPTE_FOURNISSEUR=4411    # Fournisseurs et comptes rattachés
DEFAULT_COMPTE_CHARGES=6347        # Frais bancaires et assimilés

# Format de sortie : sage100_txt | sage100_csv | sage_i7 | simple_csv
DEFAULT_FORMAT=sage100_txt

# Répertoire de sortie
DEFAULT_OUTPUT_DIR=./output
